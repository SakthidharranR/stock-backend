# Copy to .env in stock-backend (never commit .env)

# Postgres via Docker (port 5433 — avoids conflict with local Windows Postgres on 5432)
DATABASE_URL=postgres://stockapp:stockapp_dev@localhost:5433/stockapp?sslmode=disable

COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=your_app_client_id

# Finnhub (market service) — https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key

# Dev: POST /admin/sync-symbols on market service
ADMIN_API_KEY=dev-admin-key

# Dev: accept Bearer dev-* tokens with X-Dev-Email header
# Production (Lightsail): use .env.prod from .env.prod.example — DEV_AUTH_BYPASS is forced false.
DEV_AUTH_BYPASS=true

# sync-cognito (scripts/dev-reset.ps1) uses default AWS credentials:
#   aws configure
# IAM needs cognito-idp:ListUsers on your user pool
