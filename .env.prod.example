# Copy to .env.prod on the Lightsail server. Never commit .env.prod.
# Load with: docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml ...

# Public hostname for HTTPS (no https://). Convert Lightsail IP 1.2.3.4 → 1-2-3-4.sslip.io
API_PUBLIC_HOST=1-2-3-4.sslip.io
ACME_EMAIL=you@example.com

# Strong password (letters + numbers only — it is embedded in DATABASE_URL)
POSTGRES_PASSWORD=change_me_to_a_long_random_string

# CloudFront origin of the SPA (no trailing slash). Comma-separate if you have more than one.
CORS_ALLOWED_ORIGINS=https://d111111abcdef8.cloudfront.net

COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=your_spa_client_id

# IAM user/key with cognito-idp:AdminGetUser and cognito-idp:ListUsers (SSO password message)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=

FINNHUB_API_KEY=your_finnhub_api_key
ADMIN_API_KEY=change_me_admin_key
